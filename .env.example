# For LOCAL DEVELOPMENT ONLY. Copy to .env and choose a NEW password.
# Never commit .env, real passwords, credentials, API keys, or model secrets.
POSTGRES_DB=aq_uai
POSTGRES_USER=aq_uai_dev
POSTGRES_PASSWORD=CHANGE_THIS_BEFORE_STARTING_2026

# Localhost-only published ports. Change these if already in use.
WEB_HOST_PORT=8000
API_HOST_PORT=8001
POSTGRES_HOST_PORT=55432

# WP2 logins. Generate different passwords for all three roles.
AQ_UAI_MIGRATION_PASSWORD=CHANGE_THIS_MIGRATION_PASSWORD
AQ_UAI_RUNTIME_PASSWORD=CHANGE_THIS_RUNTIME_PASSWORD

# API configuration (database connection fields are injected by Compose)
AQ_UAI_ENVIRONMENT=development

# WP3. Replace the placeholder with 32 random bytes encoded as 64 hex characters.
AQ_UAI_AUTH_THROTTLE_KEY=CHANGE_THIS_AUTH_THROTTLE_KEY
# Default origin follows WEB_HOST_PORT. Override only for an explicitly configured HTTPS host.
# AQ_UAI_AUTH_ORIGIN=http://admin.localhost:8000
AQ_UAI_AUTH_ALLOW_HTTP_LOCAL=true
# Optional exact, non-loopback private nginx peer. Leave empty for the local default.
# AQ_UAI_AUTH_TRUSTED_PROXY_IP=

# MDL (Phase 3, M2). Provider-credential encryption key ring, given to the api service ONLY.
# Format: comma-separated key_id:base64(32 random bytes); key_id = 1-32 of [a-z0-9_-].
# Generate a key:  python3 -c "import base64,os; print('k1:' + base64.b64encode(os.urandom(32)).decode())"
# Rotation: append a new entry, point ACTIVE_KEY_ID at it, keep old entries until every stored
# credential has been re-encrypted. Back the key ring up separately from database backups:
# losing it makes every stored provider secret unrecoverable (re-entry is the only recovery).
# Placeholders below are rejected; the API still starts and reports MDL credentials unavailable.
AQ_UAI_MDL_CREDENTIAL_KEYS=CHANGE_THIS_KEY_ID:CHANGE_THIS_BASE64_32_BYTES
AQ_UAI_MDL_CREDENTIAL_ACTIVE_KEY_ID=CHANGE_THIS_KEY_ID

# MDL (Phase 3, M4/M5). Connection-test egress allowlist for INTERNAL providers, api service only.
# Comma-separated entries, each WITH a port: host:port, IPv4[/n]:port or [IPv6[/n]]:port,
# e.g. "ollama:11434,10.20.0.0/16:8000". An entry without a port makes the list invalid.
# Empty = no internal provider can be tested. External providers ignore this list: they must use
# https on port 443 with a public host name. Link-local/metadata (169.254.0.0/16), multicast and
# 0.0.0.0/8 are always refused; loopback needs an explicit CIDR. Never list db, api or nginx.
# A provider that sends a stored secret must use https, internal ones included.
AQ_UAI_MDL_EGRESS_INTERNAL_ALLOWLIST=
# Optional: path (inside the api container) of a PEM CA bundle for internal https providers
# signed by a private CA. Mount the file read-only; it never replaces the system trust store.
AQ_UAI_MDL_EGRESS_INTERNAL_CA_FILE=

# Optional SYNTHETIC AI provider for demos (MDL decision D15; not a real vendor, no external call).
# Start with: bash scripts/dev-up.sh --demo-provider   (adds infra/compose.demo-provider.yaml)
# The key you will type as the provider's Bearer secret in the admin UI; 16+ characters, e.g.
#   python3 -c "import secrets; print('AQ_DEMO_PROVIDER_API_KEY=demo-' + secrets.token_urlsafe(24))"
# AQ_DEMO_PROVIDER_API_KEY=
# AQ_DEMO_PROVIDER_MODELS=demo-chat,demo-chat-mini
