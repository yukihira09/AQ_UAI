# For LOCAL DEVELOPMENT ONLY. Copy to .env and choose a NEW password.
# Never commit .env, real passwords, credentials, API keys, or model secrets.
POSTGRES_DB=aq_uai
POSTGRES_USER=aq_uai_dev
POSTGRES_PASSWORD=CHANGE_THIS_BEFORE_STARTING_2026

# Localhost-only published ports. Change these if already in use.
WEB_HOST_PORT=8000
API_HOST_PORT=8001
POSTGRES_HOST_PORT=55432

# WP2 logins. Generate different passwords for all three roles.
AQ_UAI_MIGRATION_PASSWORD=CHANGE_THIS_MIGRATION_PASSWORD
AQ_UAI_RUNTIME_PASSWORD=CHANGE_THIS_RUNTIME_PASSWORD

# API configuration (database connection fields are injected by Compose)
AQ_UAI_ENVIRONMENT=development

# WP3. Replace the placeholder with 32 random bytes encoded as 64 hex characters.
AQ_UAI_AUTH_THROTTLE_KEY=CHANGE_THIS_AUTH_THROTTLE_KEY
# Default origin follows WEB_HOST_PORT. Override only for an explicitly configured HTTPS host.
# AQ_UAI_AUTH_ORIGIN=http://admin.localhost:8000
AQ_UAI_AUTH_ALLOW_HTTP_LOCAL=true
# Optional exact, non-loopback private nginx peer. Leave empty for the local default.
# AQ_UAI_AUTH_TRUSTED_PROXY_IP=
